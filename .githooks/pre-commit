#!/bin/sh
# Versioned pre-commit hook: personal-information / secret leak scan of the STAGED content.
# Enable once per clone:  git config core.hooksPath .githooks
# Logic lives in scripts/pii_scan.py (Python 3 stdlib only). Bypass deliberately: git commit --no-verify
root=$(git rev-parse --show-toplevel) || exit 1
if ! command -v python3 >/dev/null 2>&1; then
  echo "pii-scan: python3 not found, commit blocked (install Python 3 or bypass with: git commit --no-verify)" >&2
  exit 1
fi
exec python3 "$root/scripts/pii_scan.py"
