# pii-scan vision provider settings — copy to `.pii-scan.env` (repo root, git-ignored) or to
# ~/.config/pii-scan/env (applies to every repo on this device), then fill in real values.
# Format: KEY=VALUE per line. Environment variables override these files; the repo file overrides the user file.
# Only needed for commits that stage images; text files are checked offline without any provider.
# Check what's picked up (values are never printed):  python3 scripts/pii_scan.py --show-config

# --- Option A: any OpenAI-compatible Chat Completions endpoint that accepts image_url inputs ---
# Base URL without the trailing /chat/completions, e.g. https://api.example.com/v1
PII_SCAN_BASE_URL=https://llm-gateway.example.com/v1
PII_SCAN_API_KEY=replace-with-your-key
# Vision-capable model id offered by that endpoint (required for option A)
PII_SCAN_MODEL=your-vision-model-id

# --- Option B: IBM ICA gateway (used only when PII_SCAN_BASE_URL is NOT set) ---
# Model defaults to gemini-3.6-flash and reasoning_effort to low unless set below.
#ICA_BASE_API_URL=https://ica-gateway.example.com/your/path
#ICA_API_KEY=replace-with-your-key

# --- Optional tuning ---
#PII_SCAN_REASONING=low            # reasoning_effort; only sent when set (ICA: default low, "off" disables)
#PII_SCAN_USER_AGENT=pii-scan-precommit/1.0
#PII_SCAN_TIMEOUT=30               # seconds per image
#PII_SCAN_TOTAL_TIMEOUT=300        # seconds for all images
#PII_SCAN_WORKERS=4                # parallel requests
#PII_SCAN_NO_CACHE=1               # ignore the per-image result cache in .git/
#PII_SCAN_ALLOW_OFFLINE=1          # don't block commits when images couldn't be checked
